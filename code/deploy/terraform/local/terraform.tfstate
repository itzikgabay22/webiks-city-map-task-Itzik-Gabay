            "values": [
              "\"chartChecksum\": \"e81abba467ba6a8af482751edd82d523cb95e40c\"\n\"martin\":\n  \"config\": |\n    # Martin tile server: vector tiles for the public data layers.\n    # District outlines are part of the static basemap and are not served here.\n    listen_addresses: '0.0.0.0:3000'\n    worker_processes: 4\n    cache_size_mb: 256\n\n    postgres:\n      connection_string: ${DATABASE_URL}\n      pool_size: 20\n      auto_publish: false\n      tables:\n        parcels:\n          schema: public\n          table: parcels\n          srid: 4326\n          geometry_column: geom\n          geometry_type: POLYGON\n          minzoom: 12\n          properties:\n            parcel_code: text\n            land_use: text\n        announcements:\n          schema: public\n          table: announcements\n          srid: 4326\n          geometry_column: geom\n          geometry_type: GEOMETRY\n          properties:\n            kind: text\n            title: text\n            dataset_version: text\n"
            ],
            "verify": false,
            "version": "0.7.0",
