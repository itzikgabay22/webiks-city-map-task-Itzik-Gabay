              "revision": 1,
              "values": "{\"chartChecksum\":\"e81abba467ba6a8af482751edd82d523cb95e40c\",\"martin\":{\"config\":\"# Martin tile server: vector tiles for the public data layers.\\n# District outlines are part of the static basemap and are not served here.\\nlisten_addresses: '0.0.0.0:3000'\\nworker_processes: 4\\ncache_size_mb: 256\\n\\npostgres:\\n  connection_string: ${DATABASE_URL}\\n  pool_size: 20\\n  auto_publish: false\\n  tables:\\n    parcels:\\n      schema: public\\n      table: parcels\\n      srid: 4326\\n      geometry_column: geom\\n      geometry_type: POLYGON\\n      minzoom: 12\\n      properties:\\n        parcel_code: text\\n        land_use: text\\n    announcements:\\n      schema: public\\n      table: announcements\\n      srid: 4326\\n      geometry_column: geom\\n      geometry_type: GEOMETRY\\n      properties:\\n        kind: text\\n        title: text\\n        dataset_version: text\\n\"},\"secrets\":{\"dbPassword\":\"(sensitive value)\",\"jwtSecret\":\"(sensitive value)\"}}",
